{
  "name": "template",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "cli": "bun src/lib/cli-handler.ts",
    "build": "bun --bun vite build",
    "start": "bun run server.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check .",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "effect-tsgo patch",
    "shadcn:update": "for file in src/components/ui/*.tsx; do bunx shadcn@latest add -y -o $(basename \"$file\" .tsx); done"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@krak-stack/auth": "0.2.7",
    "@krak-stack/registry": "0.1.27",
    "@lucas-barake/effect-form-react": "0.26.0-beta.5",
    "@tanstack/highlight": "^0.0.10",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "4.0.0-rc.112",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.38.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@inlang/paraglide-js": "^2.25.0",
    "@oxlint/plugins": "^1.80.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
