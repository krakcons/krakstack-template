DATABASE_URL=postgresql://user:password@host:5432/dbname
TEST_DATABASE_URL=postgresql://user:password@host:5432/dbname_test
VITE_SITE_URL=http://localhost:3000
# Stable server-only secret, at least 32 characters; share across app instances.
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
VITE_KRAKSTACK_AUTH_URL=http://localhost:3001
VITE_KRAKSTACK_AUTH_PROJECT_ID=replace-with-project-id
KRAKSTACK_AUTH_URL=http://localhost:3001
KRAKSTACK_AUTH_SERVICE_API_KEY=replace-with-service-api-key
KRAKSTACK_TEMPLATE_API_KEY=replace-with-user-api-key
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_SERVICE_NAME=krakstack-template-local
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=development
